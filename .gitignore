# SARMAD Attendance - Git Ignore

# Production config with real credentials
config/config.php
.env

# Release packages built by build.sh (the --with-config ZIP contains the
# production config above - it must never be committed)
/release/
/*.zip

# Installer lock
storage/installed.lock

# Runtime logs, cache, exports and temporary uploads
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/tmp/*
!storage/tmp/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep
uploads/customers/*
!uploads/customers/.gitkeep

# OS and Editor files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
