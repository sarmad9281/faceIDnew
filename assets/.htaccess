# =====================================================================
# assets/ - public static files (CSS/JS, face-recognition models)
# =====================================================================
# The root .htaccess denies serving *.json (and other internal types)
# anywhere, which also blocked the face-api.js weight manifests:
#   assets/models/face-api-1.0.0/*-weights_manifest.json  -> HTTP 403
# and broke every camera screen ("failed to fetch ... 403"), because
# the camera flow loads the model before it can start.
#
# This directory is static-only BY DESIGN (the root rewrite rules pass
# assets/ through untouched), so known-safe static types are explicitly
# granted here. This grant is scoped to THIS directory tree only: the
# root deny still protects composer.json, config, *.sql, *.md etc.
# everywhere else.
#
# NEVER place secrets or generated/sensitive data under assets/ -
# everything here is world-readable by definition.
# =====================================================================

<FilesMatch "(?i)\.(json|js|css|png|jpg|jpeg|webp|svg|ico|woff|woff2)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Defence in depth (same posture as uploads/.htaccess): code inside a
# static directory must never run, even if a file is dropped here by
# mistake. The model shard files (-shard1/-shard2, extensionless) are
# unaffected by both rules and are served as plain downloads.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
