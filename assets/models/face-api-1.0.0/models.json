{
  "name": "SARMAD Attendance face model set",
  "version": "1.0.0",
  "model_version": "face-api.js@0.22.2/face_recognition-128d/v1",
  "engine": "face-api.js",
  "engine_license": "MIT",
  "runtime": {
    "library": "@tensorflow/tfjs",
    "library_version": "1.7.4",
    "library_path": "assets/vendor/tfjs-1.7.4.min.js",
    "engine_path": "assets/vendor/face-api-0.22.2.min.js",
    "note": "Pinned to the version face-api.js 0.22.2 is built against; verified in Chromium (WebGL) and with the pure JS CPU fallback."
  },
  "embedding": {
    "model": "face_recognition_model",
    "dimensions": 128,
    "metric": "euclidean",
    "default_threshold": 0.55,
    "note": "The descriptor is produced locally in the browser. Only the 128 numbers are stored/synced; a camera image is never sent to the server for recognition."
  },
  "detectors": {
    "tiny_face_detector": {
      "files": [
        "tiny_face_detector_model-weights_manifest.json",
        "tiny_face_detector_model-shard1"
      ],
      "default": true,
      "why": "Runs comfortably on economical Android tablets (single small CNN)."
    },
    "ssd_mobilenetv1": {
      "files": [
        "ssd_mobilenetv1_model-weights_manifest.json",
        "ssd_mobilenetv1_model-shard1",
        "ssd_mobilenetv1_model-shard2"
      ],
      "default": false,
      "why": "More accurate on small/angled faces, ~4x slower; shipped for deployments that can afford it."
    }
  },
