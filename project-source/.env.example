# =====================================================================
# SARMAD Attendance - Environment Configuration Example (.env.example)
# =====================================================================
# This file is for documentation and containerized / dotenv environments.
# On DirectAdmin shared hosting, SARMAD Attendance reads its configuration
# from `config/config.php` (created automatically by the installer or copied
# from `config/config.sample.php`).
#
# DO NOT COMMIT REAL PASSWORDS OR APP KEYS TO GITHUB.
# =====================================================================

# Application Settings
APP_NAME="SARMAD Attendance"
APP_ENV=production
APP_DEBUG=false
APP_URL="https://example.com"
APP_TIMEZONE="Asia/Tehran"
APP_LOCALE="fa_IR"
APP_KEY="base64:REPLACE_WITH_BASE64_32_BYTES_RANDOM_KEY"

# Database Connection (MySQL / MariaDB)
# Note: Project shares database with other systems; only tables
# prefixed with DB_PREFIX will ever be created or touched.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sarmadfa_clinic
DB_USER=sarmadfa_example_user
DB_PASSWORD=YourSecurePassword123#
DB_PREFIX=attendance_
DB_CHARSET=utf8mb4

# Session & Security
SESSION_NAME=sarmad_att_sid
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_SAMESITE=Lax
PASSWORD_ALGO=bcrypt
PASSWORD_COST=12

# Feature Flags & Modules (enabled by customer/manager)
FEATURE_FACE_RECOGNITION=true
FEATURE_OFFLINE_SYNC=true
FEATURE_PAYROLL=true
FEATURE_REPORTS_EXCEL=true
FEATURE_TELEGRAM_BOT=false

# Telegram Notifications (optional - tokens stored encrypted in database)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example"
TELEGRAM_DEFAULT_CHAT_ID=""
