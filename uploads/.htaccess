# ---------------------------------------------------------------------
# uploads/ is web readable (employee photos, logos) but must NEVER
# execute code. This is the single most important upload hardening rule
# on shared hosting.
# ---------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .shtml .cgi .pl .py .sh .asp .aspx
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .shtml .cgi .pl .py .sh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .shtml

Options -Indexes -ExecCGI

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^.*\.(php[0-9]?|phtml|phar|pht|shtml|cgi|pl|py|sh)$ - [F,L,NC]
</IfModule>

<FilesMatch "\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
